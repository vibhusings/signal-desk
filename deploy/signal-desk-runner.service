# Template: scripts/install-systemd.sh fills in __USER__, __GROUP__, __HOME__, __REPO__, __NODE__ and __ENV_FILE__.
[Unit]
Description=Signal Desk cloud runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__REPO__
EnvironmentFile=__ENV_FILE__
Environment=HOME=__HOME__
Environment=PATH=/usr/local/bin:/usr/bin:/bin:__HOME__/.local/bin
ExecStart=__NODE__ --import tsx src/bridge/runner.ts
Restart=always
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGTERM
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__REPO__/.runtime __HOME__/.claude

[Install]
WantedBy=multi-user.target
