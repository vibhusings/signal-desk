# Signal Desk runner settings.
#
# Cloud runner: copy to runner.env, fill in, then `bash scripts/install-systemd.sh runner.env`
# (installed as /etc/signal-desk/runner.env). Local CLI runs: copy to .env in the repo root.
#
# Keep every comment on its own line. systemd does not strip "# ..." after a value,
# so `SENDER_NAME=Alex # note` would make the name "Alex # note".

# --- Who sends --------------------------------------------------------------
# The Gmail address connected to your Slashy account. Must match exactly what you
# connect in the site's Settings -> Slashy. Replies and calendar are read from it.
SENDER_INBOX=
# Name used to sign emails and in meeting titles ("Recipient <> Name - Purpose").
SENDER_NAME=

# --- Attio -------------------------------------------------------------------
# Outreach state lives on Attio Companies records. Create an API key in Attio
# (Workspace settings -> Developers) with read/write on records and object
# configuration, then run `npm run setup:attio -- --write` once.
ATTIO_API_KEY=
ATTIO_OBJECT=companies
# Investment CRM export (contacts, funds, deals, weekly summaries). Usually the same
# key and workspace; create the object once with
# `node --import tsx scripts/setup-investment-crm.ts --write`.
CRM_ATTIO_API_KEY=
CRM_ATTIO_OBJECT=investment_crm
# Must equal SENDER_INBOX, or the CRM export stays disabled.
CRM_ATTIO_INBOX=

# --- Claude ------------------------------------------------------------------
# Path to the Claude Code CLI on this machine (`command -v claude`).
CLAUDE_BIN=/usr/bin/claude
# 1 = the runner only uses credentials supplied through the site (Claude API key or
# subscription mode, and the Slashy connection). Recommended for every cloud install.
RUNNER_BYOK_REQUIRED=1
# 1 = allow "Personal testing with Claude subscription" in the site's Settings. The
# runner then uses the Claude Code login of the service user (`claude auth login`).
# Leave 0 to require an Anthropic API key entered in Settings.
RUNNER_PERSONAL_TESTING=0
# Optional model overrides. Mailbox and send tool calls use SEND_MODEL (Haiku);
# research, signals and drafting use Sonnet; CRM fact extraction uses CRM_MODEL.
SEND_MODEL=claude-haiku-4-5
DISCOVER_MODEL=claude-sonnet-5
DRAFT_MODEL=claude-sonnet-5
CRM_MODEL=claude-sonnet-4-6

# --- Sending safety -----------------------------------------------------------
# Start at 0. The site shows "sending off" and refuses launches until you set 1 and
# restart the runner, after a test with Settings -> Test delivery turned on.
RUNNER_SEND_ENABLED=0
# Hard ceiling on emails per scheduler pass.
BATCH_CAP=20
# First email plus up to three follow-ups.
MAX_TOUCHES=4
# Minutes between touches: 3, 4 and 7 days.
INTERVALS_MINUTES=4320,5760,10080
CLAIM_LOCK_MINUTES=15
# Local CLI only: 1 logs intended sends without sending. The cloud runner overrides it.
DRY_RUN=1
RUNNER_POLL_MS=10000

# --- Replies and meetings ------------------------------------------------------
# 1 = book a meeting automatically when a reply proposes times.
AUTO_AVAILABILITY=1
REPLY_BATCH_CAP=3
REPLY_TIMEOUT_MS=120000
MEETING_TIMEZONE=America/Los_Angeles
MEETING_MINUTES=30
MEETING_START_HOUR=9
MEETING_END_HOUR=17
MEETING_NOTICE_HOURS=2
# gmeet adds a Google Meet link; "none" books without video.
MEETING_CONFERENCING=gmeet

# --- Optional -------------------------------------------------------------------
# Apollo enrichment for scripts/ingest-deck.ts only (paid API plan).
APOLLO_API_KEY=
# Local CLI only: a Claude subscription token from `claude setup-token`, or an API key.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Local CLI test harness (README "Inbox threading test"). Leave empty on the cloud runner.
TEST_RECIPIENT=
TEST_DELIVERY_RECIPIENT=
TEST_MAX_TOUCHES=1
