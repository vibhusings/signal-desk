# --- Anthropic auth for the headless send leg -------------------------------
# REQUIRED for cron/launchd. The interactive OAuth session is stored in the
# macOS Keychain, which a launchd job frequently cannot read, and it expires.
#
# PREFERRED: generate with `claude setup-token` (needs Pro/Max/Team/Enterprise).
# Prints a 1-year token to the terminal once, interactively — copy it here.
# It's a plain env var (not Keychain-backed) and rides your subscription's
# usage allowance instead of separate pay-per-token billing.
CLAUDE_CODE_OAUTH_TOKEN=

# FALLBACK: only if you don't have a Pro/Max/Team/Enterprise subscription.
# Pay-per-token, billed separately from any Claude subscription you have.
# Get one at console.anthropic.com. Leave blank if CLAUDE_CODE_OAUTH_TOKEN is set —
# the sender uses whichever one is present, preferring the token.
ANTHROPIC_API_KEY=

# --- Attio: the state machine ----------------------------------------------
ATTIO_API_KEY=
ATTIO_OBJECT=companies

# --- Apollo: contact enrichment for sourcing (scripts/ingest-deck.ts) -------
# REST API, not the Apollo MCP (which is chat-scoped and can't run from a script).
# Get one at apollo.io -> Settings -> Integrations -> API Keys. Needs a paid plan
# for API access (free tier has none). Search is free; enrichment costs ~1 credit
# per contact found, so a 39-company deck costs up to ~39 credits.
APOLLO_API_KEY=

# --- Scheduler policy -------------------------------------------------------
# Cloud deployments start with this set to 0. Change to 1 only after the Mac
# runner is stopped and the cloud test recipient has been verified.
RUNNER_SEND_ENABLED=0
# Single-user pilots set this to 1 so Claude work cannot fall back to the
# operator's OAuth token or API key. The encrypted key is supplied by the Site.
RUNNER_BYOK_REQUIRED=0
RUNNER_POLL_MS=10000  # keeps one cloud runner comfortably within Workers Free
BATCH_CAP=20          # hard ceiling on sends per run. This is the 200-blast guard.
MAX_TOUCHES=4
DRY_RUN=1             # 1 = log intended sends, send nothing. Start here.
CLAIM_LOCK_MINUTES=15

# --- Testing ----------------------------------------------------------------
# Stored email on the one Attio record permitted to run.
TEST_RECIPIENT=
# Actual inbox used only while TEST_ONLY_RECORD_ID is set and matches.
TEST_DELIVERY_RECIPIENT=
TEST_MAX_TOUCHES=1

# Reply and calendar handling (uses the same Slashy inbox as outreach)
SENDER_INBOX=
AUTO_AVAILABILITY=1
REPLY_BATCH_CAP=3
REPLY_TIMEOUT_MS=120000
MEETING_TIMEZONE=America/Los_Angeles
MEETING_MINUTES=30
MEETING_START_HOUR=9
MEETING_END_HOUR=17
MEETING_NOTICE_HOURS=24
# Used in: "Recipient <> Sender - Purpose". {company} is replaced per Attio record.
MEETING_PURPOSE=Discussing opportunities at {company}
